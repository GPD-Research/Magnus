{
  "name": "magnus",
  "private": true,
  "version": "9.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names spatial,web --prefix-colors yellow,cyan \"npm:dev:spatial\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:spatial": "cargo run -p magnus-spatial-core --bin spatial_server",
    "start": "npm run build && npm run serve",
    "serve": "cargo run -p magnus-spatial-core --bin spatial_server",
    "build:release": "npm run build && cargo build --release -p magnus-spatial-core --bin spatial_server",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
